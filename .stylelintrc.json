{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": [
      "rgb",
      "rgba",
      "hsl",
      "hsla",
      "hwb",
      "lab",
      "lch",
      "oklab",
      "oklch"
    ],
    "selector-class-pattern": [
      "^[a-z][a-zA-Z0-9]*$",
      { "message": "Use camelCase class names (accessed as styles.name)" }
    ]
  },
  "overrides": [
    {
      "files": ["src/index.css"],
      "rules": {
        "color-no-hex": null,
        "function-disallowed-list": null,
        "selector-max-class": [
          0,
          {
            "message": "Global CSS holds tokens and element styles only; put classes in a CSS Module"
          }
        ]
      }
    }
  ]
}
